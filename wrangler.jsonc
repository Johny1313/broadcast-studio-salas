{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "broadcast-studio-salas",
  "main": "./worker/src/index.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomState"
      ]
    }
  ],
  "keep_vars": true
}
